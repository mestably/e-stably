# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Email Service API Keys (Brevo, Resend, or SMTP for sending real verification emails)
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=x2.sharshar@gmail.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Estably <noreply@estably.com>
